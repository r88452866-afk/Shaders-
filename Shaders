local Tab = Window:CreateTab("Lighting Styles", nil) -- Explicitly using nil for the icon element

-- Helper function to clear old instances so styles don't stack and lag
local function ClearCurrentEffects()
    local Lighting = game:GetService("Lighting")
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("ColorCorrectionEffect") or effect:IsA("BloomEffect") or effect:IsA("SunRaysEffect") or effect:IsA("Atmosphere") then
            effect:Destroy()
        end
    end
end

